{"uid":"immersive/postfx.py::DOWNSAMPLE","name":"DOWNSAMPLE","qualname":"DOWNSAMPLE","kind":"constant","file":"immersive/postfx.py","line":12,"end_line":31,"language":"py","signature":"DOWNSAMPLE","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"","description":"","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"immersive/postfx.py","members":[],"inferred_raises":[],"returns_value":null,"value":"'#version 330 core\\nout vec4 frag;\\nuniform sampler2D uSrc;\\nuniform vec2 uTexel;\\nuniform vec2 uTarget;\\nuniform float uThreshold;\\nuniform float uKnee;\\nvoid main() {\\n    vec2 uv = gl_FragCoord.xy / uTarget;\\n    vec2 d = uTexel * 0.5;\\n    vec3 c = texture(uSrc, uv + vec2(-d.x, -d.y)).rgb + texture(uSrc, uv + vec2(d.x, -d.y)).rgb\\n           + texture(uSrc, uv + vec2(-d.x, d.y)).rgb + texture(uSrc, uv + vec2(d.x, d.y)).rgb;\\n    c *= 0.25;\\n    float luma = max(c.r, max(c.g, c.b));\\n    float soft = clamp(luma - uThreshold + uKnee, 0.0, 2.0 * uKnee);\\n    soft = soft * soft / (4.0 * uKnee + 1e-5);\\n    float gain = max(soft, luma - uThreshold) / max(luma, 1e-5);\\n    frag = vec4(c * gain, 1.0);\\n}\\n'","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"immersive/postfx.py::BLUR","name":"BLUR","qualname":"BLUR","kind":"constant","file":"immersive/postfx.py","line":33,"end_line":45,"language":"py","signature":"BLUR","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"","description":"","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"immersive/postfx.py","members":[],"inferred_raises":[],"returns_value":null,"value":"'#version 330 core\\nout vec4 frag;\\nuniform sampler2D uSrc;\\nuniform vec2 uTexel;\\nuniform vec2 uDir;\\nvoid main() {\\n    vec2 uv = gl_FragCoord.xy * uTexel;\\n    vec3 c = texture(uSrc, uv).rgb * 0.2270270270;\\n    c += (texture(uSrc, uv + uDir * uTexel * 1.3846153846).rgb + texture(uSrc, uv - uDir * uTexel * 1.3846153846).rgb) * 0.3162162162;\\n    c += (texture(uSrc, uv + uDir * uTexel * 3.2307692308).rgb + texture(uSrc, uv - uDir * uTexel * 3.2307692308).rgb) * 0.0702702703;\\n    frag = vec4(c, 1.0);\\n}\\n'","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"immersive/postfx.py::COMPOSITE","name":"COMPOSITE","qualname":"COMPOSITE","kind":"constant","file":"immersive/postfx.py","line":47,"end_line":84,"language":"py","signature":"COMPOSITE","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"","description":"","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"immersive/postfx.py","members":[],"inferred_raises":[],"returns_value":null,"value":"'#version 330 core\\nout vec4 frag;\\nuniform sampler2D uScene;\\nuniform sampler2D uBloom0;\\nuniform sampler2D uBloom1;\\nuniform sampler2D uBloom2;\\nuniform vec2 uRes;\\nuniform float uTime;\\nuniform float uExposure;\\nuniform float uBloomGain;\\nuniform float uFringe;\\n\\nfloat hash12(vec2 p) {\\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\\n    p3 += dot(p3, p3.yzx + 33.33);\\n    return fract((p3.x + p3.y) * p3.z);\\n}\\n\\nvec3 aces(vec3 x) {\\n    return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);\\n}\\n\\nvoid main() {\\n    vec2 uv = gl_FragCoord.xy / uRes;\\n    vec2 q = uv - 0.5;\\n    vec2 off = q * dot(q, q) * uFringe;\\n    vec3 hdr = vec3(texture(uScene, uv + off).r, texture(uScene, uv).g, texture(uScene, uv - off).b);\\n    vec3 bloom = texture(uBloom0, uv).rgb * 0.55 + texture(uBloom1, uv).rgb * 0.75 + texture(uBloom2, uv).rgb * 0.95;\\n    vec3 col = (hdr + bloom * uBloomGain) * uExposure;\\n    col = aces(col);\\n    float luma = dot(col, vec3(0.299, 0.587, 0.114));\\n    col = mix(col * vec3(0.93, 1.0, 1.10), col * vec3(1.07, 1.0, 0.92), smoothstep(0.18, 0.85, luma));\\n    col = pow(col, vec3(1.0 / 2.2));\\n    col *= 1.0 - dot(q, q) * 1.05;\\n    col += (hash12(gl_FragCoord.xy + fract(uTime) * 91.0) - 0.5) * 0.016;\\n    frag = vec4(max(col, 0.0), 1.0);\\n}\\n'","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
