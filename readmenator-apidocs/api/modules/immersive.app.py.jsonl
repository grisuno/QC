{"uid":"immersive/app.py::TOUR_TEXT","name":"TOUR_TEXT","qualname":"TOUR_TEXT","kind":"constant","file":"immersive/app.py","line":31,"end_line":54,"language":"py","signature":"TOUR_TEXT","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"","description":"","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"immersive/app.py","members":[],"inferred_raises":[],"returns_value":null,"value":"{'t1': {'en': 'This is a hydrogen atom. Its electron is not a dot in orbit: it is a cloud of probability.', 'es': 'Este es un atomo de hidrogeno. Su electron no es un punto orbitando: es una nube de probabilidad.'}, 't2': {'en': 'Excited states have shape. Colour is the phase of the wave: blue is positive, orange is negative.', 'es': 'Los estados excitados tienen forma. El color es la fase de la onda: azul positivo, naranja negativo.'}, 't3': {'en': 'Let us slice the cloud open. Dark gaps are nodes: places the electron never visits.', 'es': 'Abramos la nube en tajadas. Los huecos oscuros son nodos: lugares que el electron jamas visita.'}, 't4': {'en': 'Mix two states and the cloud breathes. This oscillating charge is how atoms emit light.', 'es': 'Mezcla dos estados y la nube respira. Esta carga oscilante es como los atomos emiten luz.'}, 't4b': {'en': 'The electron also has spin. Colour and arrows show its direction; in a magnetic field it precesses.', 'es': 'El electron tambien tiene spin. Color y flechas muestran su direccion; en un campo magnetico precesa.'}, 't5': {'en': 'Bring two atoms together and their clouds merge into a chemical bond.', 'es': 'Acerca dos atomos y sus nubes se funden en un enlace quimico.'}, 't6': {'en': 'Flip the phase and a node cuts the molecule in half. The bond is gone.', 'es': 'Invierte la fase y un nodo parte la molecula en dos. El enlace desaparece.'}, 't7': {'en': 'A qubit is a point on a sphere. Every quantum gate is simply a rotation.', 'es': 'Un qubit es un punto sobre una esfera. Cada compuerta cuantica es simplemente una rotacion.'}, 't8': {'en': 'Entangle two qubits: each alone becomes pure noise, yet together they are perfectly correlated.', 'es': 'Entrelaza dos qubits: cada uno solo se vuelve puro ruido, pero juntos estan perfectamente correlacionados.'}, 't9': {'en': 'Now it is your turn. Explore, slice, rotate, break things.', 'es': 'Ahora te toca a ti. Explora, corta, rota, rompe cosas.'}, 'title': {'en': 'Q2C  Quantum Lab', 'es': 'Q2C  Laboratorio Cuantico'}, 'subtitle': {'en': 'See the invisible', 'es': 'Ve lo invisible'}}","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
