{"uid":"qc_launcher.py::EXPERIENCES","name":"EXPERIENCES","qualname":"EXPERIENCES","kind":"constant","file":"qc_launcher.py","line":46,"end_line":75,"language":"py","signature":"EXPERIENCES","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"","description":"","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"qc_launcher.py","members":[],"inferred_raises":[],"returns_value":null,"value":"[Experience('tour', {'es': 'Tour cinematografico', 'en': 'Cinematic tour'}, {'es': 'Una pelicula interactiva de 80 segundos: del atomo de hidrogeno al entrelazamiento, con camara y subtitulos. Ideal para empezar.', 'en': 'An 80 second interactive film: from the hydrogen atom to entanglement, with camera work and subtitles. Best place to start.'}, VIEWER + ['--tour']), Experience('atom', {'es': 'Atomo: nubes de electrones', 'en': 'Atom: electron clouds'}, {'es': 'Nubes volumetricas calculadas en tu GPU, pixel a pixel. Corta la nube en tajadas, mira los nodos, la fase en color y superposiciones que laten.', 'en': 'Volumetric clouds computed on your GPU, pixel by pixel. Slice the cloud open, see nodes, phase as colour and beating superpositions.'}, VIEWER + ['--scene', 'atom'], True), Experience('spin', {'es': 'Spin: ver el spin del electron', 'en': 'Spin: see the electron spin'}, {'es': 'Espinores de Pauli exactos: flechas de spin dentro de la nube, precesion de Larmor en un campo magnetico y batido spin-orbita con las energias de tu backend de Dirac.', 'en': 'Exact Pauli spinors: spin arrows inside the cloud, Larmor precession in a magnetic field and spin-orbit beating using your Dirac backend energies.'}, VIEWER + ['--scene', 'spin']), Experience('matter', {'es': 'Materia: atomos y moleculas reales', 'en': 'Matter: real atoms and molecules'}, {'es': 'H a Ne y 10 moleculas (H2O, CH4, N2, O2, etileno...) calculadas ab initio con PySCF: densidad, orbitales, densidad de spin y FCI. Incluye el VQE real del proyecto para H2.', 'en': \"H to Ne and 10 molecules (H2O, CH4, N2, O2, ethylene...) computed ab initio with PySCF: density, orbitals, spin density and FCI. Includes the project's real VQE for H2.\"}, VIEWER + ['--scene', 'matter']), Experience('bloch', {'es': 'Qubit: esfera de Bloch', 'en': 'Qubit: Bloch sphere'}, {'es': 'Corre sobre tu QuantumComputer. Un qubit es un punto en una esfera. Aplica H, X, Y, Z, S, T y mira cada compuerta girar la flecha con su estela.', 'en': 'Runs on your QuantumComputer. A qubit is a point on a sphere. Apply H, X, Y, Z, S, T and watch each gate rotate the arrow, leaving a trail.'}, VIEWER + ['--scene', 'bloch']), Experience('entangle', {'es': 'Entrelazamiento', 'en': 'Entanglement'}, {'es': 'Corre sobre tu QuantumComputer. Dos esferas de Bloch y un haz entre ellas. Crea un par de Bell: las flechas se encogen a cero mientras la correlacion se vuelve perfecta.', 'en': 'Runs on your QuantumComputer. Two Bloch spheres and a beam between them. Build a Bell pair: the arrows shrink to zero while the correlation becomes perfect.'}, VIEWER + ['--scene', 'entangle']), Experience('lab', {'es': 'Laboratorio en terminal (rich)', 'en': 'Terminal lab (rich)'}, {'es': 'Las 6 lecciones interactivas, el VQE de H2 en vivo y el glosario, dentro de la terminal.', 'en': 'The 6 interactive lessons, live H2 VQE and glossary, right inside the terminal.'}, LAB)]","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
